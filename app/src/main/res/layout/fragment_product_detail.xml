<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragments.ProductDetailFragment">

    <!-- Top Action bar Navigation Header -->
    <RelativeLayout
        android:id="@+id/layout_detail_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Back Button" />

        <TextView
            style="@style/NintecSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_detail_title"
            android:layout_centerInParent="true" />

        <FrameLayout
            android:id="@+id/layout_detail_share_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/btn_detail_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Share Product" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/layout_detail_cart_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/layout_detail_share_container"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/btn_detail_cart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_cart"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Cart" />

            <TextView
                android:id="@+id/tv_detail_cart_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_cart_badge"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Scrollable main specifications contents viewport container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layout_detail_header"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_checkout_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_horizontal_margin">

            <!-- Product Showcase Image Panel Frame -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_detail_product"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher_foreground"
                    android:contentDescription="Product Showcase View" />
            </FrameLayout>

            <!-- Name and Stock Status Badge Title Row -->
            <TextView
                android:id="@+id/tv_detail_name"
                style="@style/NintecTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="MacBook Pro M3 Max" />

            <TextView
                android:id="@+id/tv_detail_stock_status"
                style="@style/NintecSmallText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_success"
                android:text="@string/label_in_stock"
                android:textColor="@color/success"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

            <!-- Pricing Presentation Blocks -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_detail_price"
                    style="@style/NintecPriceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:text="Bs 2.499,00" />

                <TextView
                    android:id="@+id/tv_detail_old_price"
                    style="@style/NintecSmallText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Bs 2.999,00"
                    android:textColor="@color/text_hint"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_default"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- Description block section -->
            <TextView
                style="@style/NintecSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_description"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_detail_description"
                style="@style/NintecBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción expandida completa del producto de alta fidelidad basado en el repositorio global maestro."
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="24dp" />

            <!-- Technical Specifications Parameters Table matrix context -->
            <TextView
                style="@style/NintecSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_specs"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/layout_detail_specs_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">
                <!-- Programmatically populated specification parameters row blocks layout line -->
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions Bar: Quantity Selector + Add to Cart + Buy Now -->
    <LinearLayout
        android:id="@+id/layout_bottom_checkout_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_secondary"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Quantity selector + Total preview -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/layout_quantity_selector"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="4dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/btn_qty_minus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_new"
                    android:backgroundTint="@color/white"
                    android:text="-"
                    android:textColor="@color/black_80"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_qty_counter"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/black_80"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btn_qty_plus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_new"
                    android:backgroundTint="@color/white"
                    android:text="+"
                    android:textColor="@color/black_80"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_bottom_total_price"
                style="@style/NintecPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textSize="18sp"
                android:text="Bs 0,00" />
        </RelativeLayout>

        <!-- Two Action Buttons: Add to Cart & Buy Now -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_detail_add_to_cart"
                style="@style/NintecSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Añadir al Carrito"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_detail_buy_now"
                style="@style/NintecPrimaryButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Compra Directa"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>