<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".fragments.CartFragment">

    <!-- Header area bar component -->
    <RelativeLayout
        android:id="@+id/layout_cart_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_cart_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/next" />

        <TextView
            style="@style/NintecSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cart_title"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Main Content Container with conditional states (Loaded vs Empty) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_cart_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layout_cart_header"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_cart_summary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_horizontal_margin">

            <!-- Filled Cart State Section -->
            <LinearLayout
                android:id="@+id/layout_filled_cart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cart_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Empty Cart State Section -->
            <LinearLayout
                android:id="@+id/layout_empty_cart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_empty_cart"
                    android:contentDescription="@string/cart_title" />

                <TextView
                    style="@style/NintecTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_cart_title"
                    android:layout_marginTop="20dp" />

                <TextView
                    style="@style/NintecBodyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_cart_desc"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btn_cart_empty_shopping"
                    style="@style/NintecPrimaryButton"
                    android:layout_width="200dp"
                    android:layout_marginTop="32dp"
                    android:text="@string/continue_shopping" />
            </LinearLayout>

            <!-- Recommendations Section (Visible in both states or specifically Empty) -->
            <TextView
                android:id="@+id/tv_recommended_title"
                style="@style/NintecSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recommended_for_you"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_cart_recommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Summary and Checkout Bar (Only visible when filled) -->
    <LinearLayout
        android:id="@+id/layout_bottom_cart_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_secondary"
        android:orientation="vertical"
        android:padding="@dimen/screen_horizontal_margin"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                style="@style/NintecBodyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtotal_label" />
            <TextView
                android:id="@+id/tv_cart_subtotal"
                style="@style/NintecBodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="$0.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <TextView
                style="@style/NintecSubtitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total_label" />
            <TextView
                android:id="@+id/tv_cart_total"
                style="@style/NintecPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:text="$0.00" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_cart_proceed"
            style="@style/NintecPrimaryButton"
            android:text="@string/proceed_order" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>