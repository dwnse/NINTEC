<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <RelativeLayout
        android:id="@+id/layout_payment_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_payment_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Back" />

        <TextView
            style="@style/NintecSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkout_payment_title"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layout_payment_header"
        app:layout_constraintBottom_toTopOf="@id/btn_payment_continue">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_horizontal_margin">

            <!-- Total Summary -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/nintec_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/NintecSmallText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_total_to_pay"
                        android:textColor="@color/white"
                        android:alpha="0.85" />

                    <TextView
                        android:id="@+id/tv_payment_total"
                        style="@style/NintecTitleText.Large"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_price_zero"
                        android:textColor="@color/white"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Payment Method Selector -->
            <TextView
                style="@style/NintecBodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_select_method"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Tab Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/tab_card"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/payment_tab_card"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/white"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/tab_qr"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/payment_tab_qr"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/text_primary"
                    android:layout_marginHorizontal="4dp" />

                <Button
                    android:id="@+id/tab_paypal"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/payment_method_paypal"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_secondary"
                    android:textColor="@color/text_primary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- CARD FORM -->
            <LinearLayout
                android:id="@+id/layout_card_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/NintecSmallText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_card_number"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/et_card_number"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input"
                            android:hint="0000 0000 0000 0000"
                            android:inputType="number"
                            android:maxLength="19"
                            android:paddingHorizontal="12dp"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    style="@style/NintecSmallText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/payment_card_expiry"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginBottom="6dp" />

                                <EditText
                                    android:id="@+id/et_card_expiry"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input"
                                    android:hint="MM/AA"
                                    android:inputType="number"
                                    android:maxLength="5"
                                    android:paddingHorizontal="12dp"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    style="@style/NintecSmallText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/payment_cvv"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginBottom="6dp" />

                                <EditText
                                    android:id="@+id/et_card_cvv"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input"
                                    android:hint="123"
                                    android:inputType="numberPassword"
                                    android:maxLength="4"
                                    android:paddingHorizontal="12dp"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            style="@style/NintecSmallText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_cardholder_name"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="6dp"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/et_card_holder"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input"
                            android:hint="Nombre como aparece en la tarjeta"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- QR FORM -->
            <LinearLayout
                android:id="@+id/layout_qr_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center_horizontal">

                        <TextView
                            style="@style/NintecBodyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_scan_qr_desc"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="16dp" />

                        <!-- QR Code placeholder -->
                        <LinearLayout
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:background="@color/white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="176dp"
                                android:layout_height="176dp"
                                android:src="@drawable/ic_nav_catalog"
                                app:tint="@color/nintec_blue"
                                android:scaleType="fitCenter"
                                android:contentDescription="QR Code" />
                        </LinearLayout>

                        <TextView
                            style="@style/NintecSmallText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_nintec_business_account"
                            android:textColor="@color/nintec_blue"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <TextView
                            style="@style/NintecSmallText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_reference_label"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="16dp" />

                        <EditText
                            android:id="@+id/et_qr_reference"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input"
                            android:hint="Nro. de transacción / referencia"
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            style="@style/NintecSmallText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_issuing_bank"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/et_qr_bank"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input"
                            android:hint="Ej: BNB, Mercantil, BCP..."
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- PAYPAL FORM -->
            <LinearLayout
                android:id="@+id/layout_paypal_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/radius_medium"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/NintecBodyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_enter_paypal_account"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            style="@style/NintecSmallText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_paypal_email"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/et_paypal_email"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input"
                            android:hint="tu@correo.com"
                            android:inputType="textEmailAddress"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/NintecSmallText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_paypal_tx_id"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="6dp"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/et_paypal_transaction"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_input"
                            android:hint="Ej: 8AB12345XY678901Z"
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/NintecSmallText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_paypal_instructions"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Branch Selector -->
            <TextView
                style="@style/NintecBodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_branch_pickup_title"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_branch_central"
                    style="@style/NintecSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/branch_central"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_branch_calacoto"
                    style="@style/NintecSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/branch_calacoto"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_branch_el_alto"
                    style="@style/NintecSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/branch_el_alto"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_branch_description"
                style="@style/NintecSmallText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment_branch_address_sample"
                android:textColor="@color/nintec_blue"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <!-- Notes -->
            <TextView
                style="@style/NintecSmallText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_additional_note_optional"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/et_payment_notes"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_input"
                android:hint="Instrucciones especiales, dirección de entrega..."
                android:inputType="textMultiLine"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:gravity="top"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btn_payment_continue"
        style="@style/NintecPrimaryButton"
        android:layout_margin="@dimen/screen_horizontal_margin"
        android:text="@string/btn_confirm_and_pay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>