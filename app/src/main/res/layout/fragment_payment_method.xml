<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragments.PaymentMethodFragment">

    <RelativeLayout
        android:id="@+id/layout_payment_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_payment_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Back" />

        <TextView
            style="@style/NintecSubtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkout_payment_title"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_horizontal_margin"
        app:layout_constraintTop_toBottomOf="@id/layout_payment_header"
        app:layout_constraintBottom_toTopOf="@id/btn_payment_continue">

        <TextView
            style="@style/NintecBodyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkout_payment_desc"
            android:layout_marginBottom="24dp" />

        <RadioGroup
            android:id="@+id/rg_payment_methods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rb_visa"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Visa / Mastercard"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                android:button="@null"
                android:drawableEnd="@android:drawable/btn_radio"
                app:buttonTint="@color/nintec_blue" />

            <RadioButton
                android:id="@+id/rb_paypal"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="PayPal"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                android:button="@null"
                android:drawableEnd="@android:drawable/btn_radio"
                app:buttonTint="@color/nintec_blue" />

            <RadioButton
                android:id="@+id/rb_qr"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Pago por QR"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="16dp"
                android:button="@null"
                android:drawableEnd="@android:drawable/btn_radio"
                app:buttonTint="@color/nintec_blue" />

        </RadioGroup>
    </LinearLayout>

    <Button
        android:id="@+id/btn_payment_continue"
        style="@style/NintecPrimaryButton"
        android:layout_margin="@dimen/screen_horizontal_margin"
        android:text="@string/btn_continue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>