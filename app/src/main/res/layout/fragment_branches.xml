<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".fragments.BranchesFragment">

    <!-- Header bar section -->
    <RelativeLayout
        android:id="@+id/layout_branches_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/NintecTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/branches_title"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Search Input layout bar container widget -->
    <LinearLayout
        android:id="@+id/layout_branches_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_branches_header">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/search_products" />

        <EditText
            android:id="@+id/et_branches_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="@string/search_branches_hint"
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- Map Placeholder / Container Frame -->
    <FrameLayout
        android:id="@+id/layout_map_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge_new"
        android:backgroundTint="@color/nintec_blue_light"
        app:layout_constraintTop_toBottomOf="@id/layout_branches_search">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/map_preview_placeholder"
            android:gravity="center"
            android:textColor="@color/nintec_blue"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Branch List Recycler Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_branches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_map_container"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty State for Search -->
    <TextView
        android:id="@+id/tv_branches_empty"
        style="@style/NintecSubtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_branches_found"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_map_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>