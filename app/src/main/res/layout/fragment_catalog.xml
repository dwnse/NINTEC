<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".fragments.CatalogFragment">

    <!-- Header / Title block container bar area -->
    <RelativeLayout
        android:id="@+id/layout_catalog_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            style="@style/NintecTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <FrameLayout
            android:id="@+id/layout_catalog_cart_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/img_catalog_cart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_cart"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Shopping Cart" />

            <TextView
                android:id="@+id/tv_catalog_cart_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_cart_badge"
                android:gravity="center"
                android:text="@string/default_badge_zero"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Search Input layout bar container widget -->
    <LinearLayout
        android:id="@+id/layout_catalog_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginHorizontal="@dimen/screen_horizontal_margin"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_catalog_header">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/et_catalog_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="Buscar productos..."
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/text_primary"
            android:inputType="text"
            android:importantForAutofill="no" />

        <ImageView
            android:id="@+id/img_catalog_search_clear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="Clear Search" />
    </LinearLayout>

    <!-- Categories Filter Horizontal Scroll Node row container -->
    <HorizontalScrollView
        android:id="@+id/scroll_catalog_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        android:clipToPadding="false"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layout_catalog_search">

        <LinearLayout
            android:id="@+id/container_catalog_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <!-- Dynamically populated tags line in Java context -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Dynamic Products Grid list Area inside viewport framework -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_catalog_products"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="10dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/scroll_catalog_categories"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty State Content Viewport Display structure placeholder -->
    <TextView
        android:id="@+id/tv_catalog_empty_state"
        style="@style/NintecSubtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_products_found"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/scroll_catalog_categories"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>