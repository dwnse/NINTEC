<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activities.LoginActivity">

    <!-- Non-bouncy Full Screen Container (No overscroll bounce, no draggable sheet feel) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <!-- Brand Logo and Header (Integrated Full-Screen) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="NINTECLP Logo"
                    android:adjustViewBounds="true"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher_foreground" />

                <TextView
                    android:id="@+id/tv_brand_name"
                    style="@style/NintecTitleText.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/brand_name"
                    android:textColor="@color/nintec_blue"
                    android:letterSpacing="0.08" />

                <TextView
                    style="@style/NintecSmallText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Inicia sesión para continuar"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Form Section (Direct Full Screen Form, Not a Floating Card) -->
            <TextView
                style="@style/NintecSmallText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/email_label"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_email"
                style="@style/NintecInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="ejemplo@nintec.com"
                android:inputType="textEmailAddress"
                android:importantForAutofill="no"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/NintecSmallText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/password_label"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_password"
                style="@style/NintecInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="10dp" />

            <!-- Remember Me -->
            <CheckBox
                android:id="@+id/cb_remember_me"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remember_me"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="20dp" />

            <!-- Main Login Button -->
            <Button
                android:id="@+id/btn_login"
                style="@style/NintecPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/login_button"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Register Navigation Link -->
            <TextView
                android:id="@+id/tv_go_to_register"
                style="@style/NintecBodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:padding="8dp"
                android:text="@string/dont_have_account"
                android:textColor="@color/nintec_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Divider -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_default"
                    android:layout_centerVertical="true" />

                <TextView
                    android:id="@+id/tv_divider"
                    style="@style/NintecSmallText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@color/white"
                    android:paddingHorizontal="12dp"
                    android:text="@string/continue_with"
                    android:textColor="@color/text_hint" />
            </RelativeLayout>

            <!-- Social Login Buttons Section -->
            <LinearLayout
                android:id="@+id/layout_social"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Google Authentication Button -->
                <LinearLayout
                    android:id="@+id/btn_google"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_button_secondary"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="10dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_google"
                        android:contentDescription="Google Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/login_google"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- iCloud/Apple Authentication Button -->
                <LinearLayout
                    android:id="@+id/btn_icloud"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_button_secondary"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_apple"
                        android:contentDescription="iCloud Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/login_icloud"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>