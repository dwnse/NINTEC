<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".activities.LoginActivity">

    <!-- Decorative Top Background Shape -->
    <View
        android:id="@+id/decor_top"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="-150dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_decor_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative Bottom Background Shape -->
    <View
        android:id="@+id/decor_bottom"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginBottom="-150dp"
        android:background="@drawable/bg_decor_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Fully Responsive Scroll Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_horizontal_margin">

            <!-- Logo Section -->
            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="40dp"
                android:contentDescription="NINTECLP Logo"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                android:src="@drawable/ic_logo_ninteclp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <TextView
                android:id="@+id/tv_brand_name"
                style="@style/NintecTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/brand_name"
                android:letterSpacing="0.1"
                app:layout_constraintTop_toBottomOf="@id/img_logo"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <!-- Main Authentication Card -->
            <LinearLayout
                android:id="@+id/card_login"
                style="@style/NintecCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_brand_name"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <TextView
                    style="@style/NintecTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="@string/login_title" />

                <!-- Email Input Field -->
                <TextView
                    style="@style/NintecSmallText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/email_label"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_email"
                    style="@style/NintecInput"
                    android:hint="ejemplo@nintec.com"
                    android:inputType="textEmailAddress"
                    android:importantForAutofill="no" />

                <!-- Password Input Field -->
                <TextView
                    style="@style/NintecSmallText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/password_label"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_password"
                    style="@style/NintecInput"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:importantForAutofill="no" />

                <!-- Remember Me CheckBox Option -->
                <CheckBox
                    android:id="@+id/cb_remember_me"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/remember_me"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_small" />

                <!-- Main Login Button -->
                <Button
                    android:id="@+id/btn_login"
                    style="@style/NintecPrimaryButton"
                    android:layout_marginTop="24dp"
                    android:text="@string/login_button" />

                <!-- Register Navigation Link -->
                <TextView
                    android:id="@+id/tv_go_to_register"
                    style="@style/NintecBodyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:padding="8dp"
                    android:text="@string/dont_have_account"
                    android:textColor="@color/nintec_blue"
                    android:textSize="@dimen/text_size_small"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Social Divider Label -->
            <TextView
                android:id="@+id/tv_divider"
                style="@style/NintecSmallText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/continue_with"
                app:layout_constraintTop_toBottomOf="@id/card_login"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <!-- Social Login Buttons Section -->
            <LinearLayout
                android:id="@+id/layout_social"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="40dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_divider"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <!-- Google Authentication Button -->
                <LinearLayout
                    android:id="@+id/btn_google"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:background="@drawable/bg_button_secondary"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="12dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_google"
                        android:contentDescription="Google Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/login_google"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- iCloud/Apple Authentication Button -->
                <LinearLayout
                    android:id="@+id/btn_icloud"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:background="@drawable/bg_button_secondary"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_apple"
                        android:contentDescription="iCloud Icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/login_icloud"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>