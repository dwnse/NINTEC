<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/img_cart_product"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/ic_launcher_foreground"
            android:scaleType="centerInside"
            android:contentDescription="Product Image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_cart_product_name"
                style="@style/NintecBodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Product Name" />

            <TextView
                android:id="@+id/tv_cart_product_price"
                style="@style/NintecPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bs 0,00" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/btn_cart_qty_minus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="-"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_badge_new"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/black_80" />

                <TextView
                    android:id="@+id/tv_cart_qty_counter"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/black_80" />

                <TextView
                    android:id="@+id/btn_cart_qty_plus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="+"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_badge_new"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/black_80" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_cart_remove"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_delete"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Remove Item" />

    </LinearLayout>
</androidx.cardview.widget.CardView>